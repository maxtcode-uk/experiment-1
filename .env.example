# Copy this file to .env and fill in your details. Never commit .env.

# eBay developer keys (production keyset) from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_GB

VINTED_DOMAIN=www.vinted.co.uk
CURRENCY=GBP

# Resale estimate = median asking price x this (asking prices beat real sale prices)
RESALE_HAIRCUT=0.85
MIN_COMPARABLES=5
REQUEST_DELAY=1.5

# Your eBay selling fees. Private UK sellers: 0 / 0.
# Business sellers on clothing: roughly 0.128 / 0.30.
EBAY_SELLER_PCT=0
EBAY_SELLER_FIXED=0

# What it costs you to post an item when you resell it on eBay
RESALE_POSTAGE=3.50
